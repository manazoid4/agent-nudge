{
  "version": "1.0",
  "rules": [
    {
      "id": "rule-evidence-claims",
      "title": "Evidence Before Claims",
      "text": "Agents must not claim completion, correctness, or deployment without verifiable commands, outputs, or receipts.",
      "scope": "personal",
      "status": "approved",
      "confidence": "high",
      "applicableModes": ["BUILD", "REVIEW", "RESUME"],
      "applicableAgents": ["*"],
      "sourceReferences": [
        "MAZ-PROMPT-PROFILE.md#2-default-execution-rules",
        "agent-nudge/BUILD_RECEIPT.md"
      ],
      "enabled": true,
      "priority": 40
    },
    {
      "id": "rule-human-gate",
      "title": "Human Gate / Stop Condition",
      "text": "Work autonomously but STOP and ask when blocked by credentials, spending money, destructive data operations, or deployment.",
      "scope": "personal",
      "status": "approved",
      "confidence": "high",
      "applicableModes": ["*"],
      "applicableAgents": ["*"],
      "sourceReferences": ["MAZ-PROMPT-PROFILE.md#2-default-execution-rules"],
      "enabled": true,
      "priority": 40
    },
    {
      "id": "rule-surgical-edits",
      "title": "Surgical Edits",
      "text": "Touch only what must be touched. No abstractions for single-use code.",
      "scope": "personal",
      "status": "approved",
      "confidence": "high",
      "applicableModes": ["BUILD", "REVIEW"],
      "applicableAgents": ["*"],
      "sourceReferences": ["MAZ-PROMPT-PROFILE.md#2-default-execution-rules"],
      "enabled": true,
      "priority": 40
    },
    {
      "id": "rule-branch-safety",
      "title": "Source Control Branch Safety",
      "text": "Work on agents/* branches. No force pushes. No pushing to main without explicit PR request.",
      "scope": "personal",
      "status": "approved",
      "confidence": "high",
      "applicableModes": ["BUILD", "REVIEW"],
      "applicableAgents": ["*"],
      "sourceReferences": ["MAZ-PROMPT-PROFILE.md#4-common-constraints"],
      "enabled": true,
      "priority": 40
    },
    {
      "id": "rule-no-transcript-hoarding",
      "title": "No Transcript Hoarding",
      "text": "Store structured handoff receipts and excerpts. Do not store raw chat outputs to avoid token bloat.",
      "scope": "personal",
      "status": "approved",
      "confidence": "high",
      "applicableModes": ["RESUME", "PLAN", "BUILD"],
      "applicableAgents": ["*"],
      "sourceReferences": ["MAZ-PROMPT-PROFILE.md#2-default-execution-rules"],
      "enabled": true,
      "priority": 40
    },
    {
      "id": "rule-plan-build-separation",
      "title": "Plan vs Build Separation",
      "text": "Separate analysis from execution. PLAN pass writes a plan; BUILD pass executes exactly one step.",
      "scope": "temporary",
      "status": "approved",
      "confidence": "medium",
      "applicableModes": ["PLAN", "BUILD"],
      "applicableAgents": ["*"],
      "sourceReferences": ["MAZ-PROMPT-PROFILE.md#1-prompt-structures-by-mode"],
      "enabled": true,
      "priority": 50,
      "optionalProjectRestrictions": ["mazos-ui"]
    },
    {
      "id": "rule-codex-mcp",
      "title": "Codex MCP Code Discovery",
      "text": "Use codebase-memory-mcp graph tools (search_graph, trace_path) over grep/glob for code discovery.",
      "scope": "tool",
      "status": "approved",
      "confidence": "high",
      "applicableModes": ["RESEARCH", "PLAN", "BUILD"],
      "applicableAgents": ["Codex"],
      "sourceReferences": ["MAZ-PROMPT-PROFILE.md#5-research--discovery"],
      "enabled": true,
      "priority": 30
    },
    {
      "id": "rule-vault-index-first",
      "title": "Vault Discovery Index-First",
      "text": "Read indexes first (AGENTS.md, Vault Map.md), targeted search after. NEVER load the whole Obsidian vault into context.",
      "scope": "personal",
      "status": "approved",
      "confidence": "high",
      "applicableModes": ["RESEARCH", "PLAN"],
      "applicableAgents": ["*"],
      "sourceReferences": ["MAZ-PROMPT-PROFILE.md#5-research--discovery"],
      "enabled": true,
      "priority": 40
    },
    {
      "id": "rule-candidate-ab-test",
      "title": "A/B Prompt Validation",
      "text": "Test generated briefs against a known 'Conflicting Edit' simulation before applying to real repositories.",
      "scope": "personal",
      "status": "candidate",
      "confidence": "medium",
      "applicableModes": ["REVIEW"],
      "applicableAgents": ["*"],
      "sourceReferences": ["MAZ-PROFILE-RESEARCH-DELTAS.md"],
      "enabled": true,
      "priority": 40
    },
    {
      "id": "rule-rejected-slop",
      "title": "Reject Slop Framework",
      "text": "Use an overarching 10k context super-prompt.",
      "scope": "historical",
      "status": "rejected",
      "confidence": "high",
      "applicableModes": ["*"],
      "applicableAgents": ["*"],
      "sourceReferences": ["REDDIT-PRACTITIONER-NOTES.md"],
      "enabled": false,
      "priority": 40
    }
  ]
}
