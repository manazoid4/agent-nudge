# Ed25519 PEM keys. The private key signs paid licenses server-side.
# The matching public key is used by the local daemon to verify licenses.
AGENT_NUDGE_LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
AGENT_NUDGE_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"
